<!--
  ПОДРОБНЫЙ РАЗБОР РЕСУРСА themes.xml.
  strings: name становится R.string.name, значение - текст getString/setText.
  Формат %1$s/%2$s подставляет строки, %1$d - число; dp задаёт отступы, sp - текст.
  style/theme: parent наследует оформление, item переопределяет конкретный атрибут.
  values-night автоматически выбирается при тёмной теме. Цвета темы используются через ?attr.
-->
<resources>
    <!-- Контрастные ночные цвета сохраняют читаемость текста и кнопок. -->
    <style name="Theme.Lesson3" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">#AAC7FF</item><item name="colorOnPrimary">#003064</item>
        <item name="colorPrimaryContainer">#18477F</item><item name="colorOnPrimaryContainer">#D8E2FF</item>
        <item name="colorSecondaryContainer">#3F4758</item><item name="colorOnSecondaryContainer">#DCE2F0</item>
        <item name="android:fontFamily">sans</item><item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
