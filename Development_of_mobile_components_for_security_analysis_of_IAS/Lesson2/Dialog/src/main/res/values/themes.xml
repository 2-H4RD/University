<!--
  ПОДРОБНЫЙ РАЗБОР РЕСУРСА themes.xml.
  strings: name становится R.string.name, значение - текст getString/setText.
  Формат %1$s/%2$s подставляет строки, %1$d - число; dp задаёт отступы, sp - текст.
  style/theme: parent наследует оформление, item переопределяет конкретный атрибут.
  values-night автоматически выбирается при тёмной теме. Цвета темы используются через ?attr.
-->
<resources>
    <!-- Тема без ActionBar: заголовок расположен в учебной XML-разметке. -->
    <style name="Theme.Lesson2" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">#3156A3</item>
        <item name="colorPrimaryVariant">#213D7A</item>
        <item name="colorSecondary">#3156A3</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
    <!-- Общие размеры сохраняют читаемость и удобную область нажатия. -->
    <style name="ScreenTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">26sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_marginBottom">12dp</item>
    </style>
    <style name="BodyText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">16sp</item>
        <item name="android:layout_marginBottom">16dp</item>
    </style>
    <style name="ActionButton" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:layout_marginBottom">8dp</item>
    </style>
</resources>
